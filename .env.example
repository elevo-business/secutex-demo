# In Coolify als Environment Variable setzen — NICHT ins Git-Repo committen!

# ─── LLM-Provider-Chain ─────────────────────────────────────────────────
# Reihenfolge der Adapter (kommagetrennt). Default: gemini,canned
# Groq bleibt als Adapter im Code verfügbar — bei Bedarf z.B. LLM_PRIMARY=gemini, LLM_FALLBACK=groq,canned
LLM_PRIMARY=gemini
LLM_FALLBACK=canned

# Gemini (Free-Tier — primär). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# Groq (optional, OpenAI-kompatibles API). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Demo/Canned-Modus erzwingen — überspringt Groq/Gemini komplett
DEMO_MODE_FORCE=false

# ─── Härtung ────────────────────────────────────────────────────────────
# Erlaubte Origin-Header (kommagetrennt). Leer = kein Origin-Check.
ALLOWED_ORIGINS=http://localhost:3000

# Max. Body-Länge in Zeichen (HTTP 400 bei Überschreitung)
MAX_INPUT_CHARS=4000

# Rate-Limit pro IP/Minute (HTTP 429 bei Überschreitung)
RATE_LIMIT_RPM=10

# LLM-Provider-Timeout in Millisekunden (Fallback bei Überschreitung)
LLM_TIMEOUT_MS=8000

# ─── Optional: Basic Auth für die Demo-UI ───────────────────────────────
DEMO_USER=
DEMO_PASSWORD=
